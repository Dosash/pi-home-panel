# Скопируй в webcam.env (права 600) и перезапусти: sudo systemctl restart webcam
# Вход в панель выключен, пока строка закомментирована (панель только в локальной сети).
# WEBCAM_AUTH=логин:пароль
# Команда после каждого готового ролика (путь к .mp4 добавится последним аргументом):
# WEBCAM_ON_CLIP=rclone copy --no-traverse remote:webcam
