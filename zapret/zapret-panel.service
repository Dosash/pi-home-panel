[Unit]
Description=zapret settings panel (strategies from flowseal, checks)
After=network-online.target zapret.service
Wants=network-online.target

[Service]
User=dosash
Group=dosash
WorkingDirectory=/home/dosash/project/zapret
ExecStart=/usr/bin/python3 /home/dosash/project/zapret/web.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
